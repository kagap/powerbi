    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "7,793 foods from the USDA's SR Legacy database, the final release (April 2018) of the National Nutrient Database for Standard Reference. Every value is per 100 grams of the food as listed. Many foods lack some nutrients (sugars are missing for 23% of the foods, vitamin D for 33%, fibre for 7%), and an average uses only the foods that have a value. The energy bars use the usual factors (4 kilocalories for a gram of protein or carbohydrate, 9 for fat) on the values in the table, so they show where the energy of the foods in a group comes from, not what people eat. An average is an average over foods, not over what is eaten: a group with many foods of one kind counts them all.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#25311F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#25311F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Open the Filters pane on the right (the funnel tab) to filter by category or date; the selection applies to every page. Click a bar, a slice or a point to cross-filter the other charts, and hover over one to see a small summary card.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#25311F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data source",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#25311F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "U.S. Department of Agriculture, Agricultural Research Service, FoodData Central, SR Legacy (April 2018), public domain under CC0 1.0 (https://fdc.nal.usda.gov/download-datasets), retrieved on 26 October 2026. Prepared: 24 of the 149 nutrients were turned from a long table into columns, the food groups were taken from the food category table, and energy, protein, sugar, fibre and sodium bands and the main source of energy of every food were added.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#25311F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
