          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "12,330 browsing sessions of an online shop over one year. One session is one row: pages viewed, time spent, bounce and exit rates, the month, the type of visitor and whether the session ended with a purchase (Revenue). Each session belongs to a different user.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Open the Filters pane on the right (the funnel tab) to filter by category or date; the selection applies to every page. Click a bar, a slice or a point to cross-filter the other charts, and hover over one to see a small summary card.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data source",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "UCI Machine Learning Repository, Online Shoppers Purchasing Intention Dataset (Sakar et al., 2018), licence CC BY 4.0. https://archive.ics.uci.edu/dataset/468",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rows = COUNTROWS(OnlineShoppers)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Conversion rate = DIVIDE(CALCULATE(COUNTROWS(OnlineShoppers), OnlineShoppers[Revenue] = TRUE()), COUNTROWS(OnlineShoppers))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Purchasing sessions = CALCULATE(COUNTROWS(OnlineShoppers), OnlineShoppers[Revenue] = TRUE())",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average page value = AVERAGE(OnlineShoppers[PageValues])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average bounce rate = AVERAGE(OnlineShoppers[BounceRates])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average product pages = AVERAGE(OnlineShoppers[ProductRelated])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#E8F0FB"
                    }
                  }
                ]
              }
            ]
          }
        }
