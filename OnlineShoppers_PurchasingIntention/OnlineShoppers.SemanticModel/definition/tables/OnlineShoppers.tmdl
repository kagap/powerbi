table OnlineShoppers
	lineageTag: 581da352-3754-5b53-91c2-c82fa6621e25

	measure Rows = COUNTROWS(OnlineShoppers)
		formatString: #,0
		lineageTag: ac88c259-097a-5ea9-ba7f-d69a721f4a93

	measure 'Conversion rate' = DIVIDE(CALCULATE(COUNTROWS(OnlineShoppers), OnlineShoppers[Revenue] = TRUE()), COUNTROWS(OnlineShoppers))
		formatString: 0.0%
		lineageTag: a05b2d84-154a-50cf-bf0e-e1b77dd9ae74

	measure 'Purchasing sessions' = CALCULATE(COUNTROWS(OnlineShoppers), OnlineShoppers[Revenue] = TRUE())
		formatString: #,0
		lineageTag: 1ba75f54-604d-5e67-bb74-6d4b0bb64ce9

	measure 'Average page value' = AVERAGE(OnlineShoppers[PageValues])
