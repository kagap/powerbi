table WineQuality
	lineageTag: 59a03dab-5f8d-51cd-b749-87fd93635e27

	measure Wines = COUNTROWS(WineQuality)
		formatString: #,0
		lineageTag: fb47e6e4-f292-5700-bf6a-d3c871eb9fd3

	measure 'Average quality' = AVERAGE(WineQuality[Quality])
		formatString: 0.00
		lineageTag: c2dc3624-3ef5-5a6b-9fc5-a7a61373d826

	measure 'Average alcohol' = AVERAGE(WineQuality[Alcohol])
		formatString: 0.0
		lineageTag: 87309b97-70bb-5b0d-a73a-3600a75caf1a

	measure 'Average volatile acidity' = AVERAGE(WineQuality[Volatile_acidity])
		formatString: 0.00
		lineageTag: 82741981-f9ff-576a-9dd1-c7e90dfed8e5

	measure 'Average residual sugar' = AVERAGE(WineQuality[Residual_sugar])
		formatString: 0.0
		lineageTag: 81274405-5907-5edd-91f6-3d27470db542

	measure 'Share of good wines' = DIVIDE(CALCULATE(COUNTROWS(WineQuality), WineQuality[Quality] >= 7), COUNTROWS(WineQuality))
		formatString: 0.0%
		lineageTag: 000a3a7d-086e-54a9-b407-2228302427a5

	measure 'Average sulphates' = AVERAGE(WineQuality[Sulphates])
		formatString: 0.00
		lineageTag: 62415ccb-41cd-56df-aedf-1b8240fd7b84

