              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#2B1A1F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Wines = COUNTROWS(WineQuality)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B1A1F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average quality = AVERAGE(WineQuality[Quality])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B1A1F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average alcohol = AVERAGE(WineQuality[Alcohol])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B1A1F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average volatile acidity = AVERAGE(WineQuality[Volatile_acidity])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B1A1F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average residual sugar = AVERAGE(WineQuality[Residual_sugar])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2B1A1F"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Share of good wines = DIVIDE(CALCULATE(COUNTROWS(WineQuality), WineQuality[Quality] >= 7), COUNTROWS(WineQuality))",
