	partition GarmentProductivity = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.Decompress(Binary.FromText("" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"", BinaryEncoding.Base64), Compression.GZip), [Delimiter=",", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted, {{"Department", type text}, {"Day", type text}, {"Week", type text}, {"Team", type text}, {"Targeted_productivity", type number}, {"SMV", type number}, {"WIP", type number}, {"Overtime_min", Int64.Type}, {"Incentive", Int64.Type}, {"Idle_time", type number}, {"Idle_men", Int64.Type}, {"Style_changes", Int64.Type}, {"Workers", type number}, {"Actual_productivity", type number}, {"Target", type text}, {"Incentive_band", type text}, {"Overtime_per_worker_band", type text}}, "en-US"),
				Dates0 = Table.TransformColumns(Typed, {{"Date", each if _ = null or _ = "" then null else Date.FromText(Text.From(_), [Culture="en-US", Format="yyyy-MM-dd"]), type date}}),
				AddMonth = Table.AddColumn(Dates0, "Month", each Date.StartOfMonth(DateTime.Date(Record.Field(_, "Date"))), type date),
				AddYear = Table.AddColumn(AddMonth, "Year", each Date.Year(Record.Field(_, "Month")), Int64.Type)
			in
				AddYear
