table GarmentProductivity
	lineageTag: 5d8fec04-02de-55a3-b330-92b9773a9dae

	measure 'Team days' = COUNTROWS(GarmentProductivity)
		formatString: #,0
		lineageTag: 9fb1aaac-259d-5c7c-9ae4-c3aca5b708a4

	measure 'Average productivity' = AVERAGE(GarmentProductivity[Actual_productivity])
		formatString: 0.0%
		lineageTag: 565082f9-74fa-5c82-9c71-035659b818c7

	measure 'Target met share' = DIVIDE(CALCULATE(COUNTROWS(GarmentProductivity), GarmentProductivity[Target] = "Met"), COUNTROWS(GarmentProductivity))
		formatString: 0.0%
		lineageTag: 5252d6f4-17d1-519c-8fdb-46db1f7abab1

	measure 'Average target' = AVERAGE(GarmentProductivity[Targeted_productivity])
		formatString: 0.0%
		lineageTag: 7a82ff86-3c6c-5020-9856-c73ad2584601

	measure 'Overtime per worker (min)' = DIVIDE(SUM(GarmentProductivity[Overtime_min]), SUM(GarmentProductivity[Workers]))
		formatString: #,0
		lineageTag: f48899f7-a534-551e-aef9-2074d29c4cb1

	measure 'Average incentive' = AVERAGE(GarmentProductivity[Incentive])
		formatString: #,0
		lineageTag: 7245bd20-a7b9-5a32-8f10-c7d0cd918db8

