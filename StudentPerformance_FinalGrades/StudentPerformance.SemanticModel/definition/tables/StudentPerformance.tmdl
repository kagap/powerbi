table StudentPerformance
	lineageTag: 77a75a38-1f13-5e9b-bfd4-7cceecb1409b

	measure Enrolments = COUNTROWS(StudentPerformance)
		formatString: #,0
		lineageTag: 42f94bdc-6eec-5366-b67a-ace87de5d8d2

	measure 'Average final grade' = AVERAGE(StudentPerformance[Final_grade])
		formatString: 0.0
		lineageTag: 097ce633-8991-5c2d-99d1-2379a8ad3e30

	measure 'Pass rate' = DIVIDE(CALCULATE(COUNTROWS(StudentPerformance), StudentPerformance[Result] = "Passed"), COUNTROWS(StudentPerformance))
		formatString: 0.0%
		lineageTag: f17bed2a-f34e-5d8d-b3f7-5a3a72064c05

	measure 'Average absences' = AVERAGE(StudentPerformance[Absences])
		formatString: 0.0
		lineageTag: 46d8396f-4c05-5327-a982-4efb1965c7c2

	measure 'Average first-period grade' = AVERAGE(StudentPerformance[Grade_period_1])
		formatString: 0.0
		lineageTag: d90af667-1b24-5481-bd9b-b9eb4f33e3fa

	measure 'Aiming for higher education' = DIVIDE(CALCULATE(COUNTROWS(StudentPerformance), StudentPerformance[Wants_higher_education] = "Yes"), COUNTROWS(StudentPerformance))
		formatString: 0.0%
		lineageTag: 5c938267-842f-5483-9bc7-544e88ee640d

