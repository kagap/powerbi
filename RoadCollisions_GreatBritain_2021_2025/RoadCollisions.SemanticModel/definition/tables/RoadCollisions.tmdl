table RoadCollisions
	lineageTag: 98b2b7a0-e620-57e8-9078-7fec36897f01

	measure Records = COUNTROWS(RoadCollisions)
		formatString: #,0
		lineageTag: 9ef8d102-1882-59a7-aee4-fb62b1566c15

	measure Collisions = SUM(RoadCollisions[Collision_count])
		formatString: #,0
		lineageTag: 08dfe455-9bb0-5f47-8ac5-f72efbe57f83

	measure Casualties = SUM(RoadCollisions[Casualty_count])
		formatString: #,0
		lineageTag: 76192d4f-a563-5c2e-a785-b47645f9a65c

	measure 'Fatal collisions' = CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Severity] = "1 Fatal")
		formatString: #,0
		lineageTag: fcdcae81-13cb-523e-9f54-67779704e4a8

	measure 'Serious collisions' = CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Severity] = "2 Serious")
		formatString: #,0
		lineageTag: e07e5af2-bdf4-5d7e-9973-7fe99f049afb

	measure 'Fatal or serious share' = DIVIDE(CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Severity] <> "3 Slight"), SUM(RoadCollisions[Collision_count]))
		formatString: 0.0%
		lineageTag: 7c09f50a-e4de-5997-8450-de36d71a5797

	measure 'Casualties per collision' = DIVIDE(SUM(RoadCollisions[Casualty_count]), SUM(RoadCollisions[Collision_count]))
		formatString: 0.00
		lineageTag: 1c79efd0-86c5-5f18-8494-dc5c281518a8

	measure 'Vehicles per collision' = DIVIDE(SUM(RoadCollisions[Vehicle_count]), SUM(RoadCollisions[Collision_count]))
		formatString: 0.00
		lineageTag: 10aa6132-d892-5d12-9917-0918d76b2eae

	measure 'Dark share' = DIVIDE(CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Light] <> "Daylight", RoadCollisions[Light] <> "Not listed"), SUM(RoadCollisions[Collision_count]))
		formatString: 0.0%
		lineageTag: 5f0818e9-11ef-51dc-8cf3-81b01060f8fa

	measure 'Wet or icy share' = DIVIDE(CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Surface] = "Wet or damp" || RoadCollisions[Surface] = "Frost or ice" || RoadCollisions[Surface] = "Snow" || RoadCollisions[Surface] = "Flood over 3 cm"), SUM(RoadCollisions[Collision_count]))
		formatString: 0.0%
		lineageTag: 5123a097-e72d-513f-9b90-e9694f8e7ab3

	measure 'Fatal collisions per 1,000' = DIVIDE(CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Severity] = "1 Fatal"), SUM(RoadCollisions[Collision_count])) * 1000
		formatString: 0.0
		lineageTag: 97f812a5-386e-546d-b008-5bb0f1a35017

	measure 'Force latitude' = AVERAGE(RoadCollisions[Force_lat])
		formatString: 0.00
		lineageTag: 8c343b6e-f8f8-541a-b0e6-19f4ed22c1eb

	measure 'Force longitude' = AVERAGE(RoadCollisions[Force_lon])
		formatString: 0.00
		lineageTag: 2000508f-91c2-5e76-99f2-a7ff8b65ca4d

	measure 'Collisions a month' = DIVIDE(SUM(RoadCollisions[Collision_count]), DISTINCTCOUNT(RoadCollisions[Date]))
		formatString: #,0
		lineageTag: 6c3773b3-038c-5b60-9df7-686f9078c2d2

	measure 'Rural share' = DIVIDE(CALCULATE(SUM(RoadCollisions[Collision_count]), RoadCollisions[Area] = "Rural"), SUM(RoadCollisions[Collision_count]))
		formatString: 0.0%
		lineageTag: fd866de2-99a9-5cca-ac57-9de9b74f1f57

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 8c87fe6e-4b21-5608-ae49-cdb2f034d5b5
		summarizeBy: none
		sourceColumn: "Date"

