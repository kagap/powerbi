					""}), BinaryEncoding.Base64), Compression.GZip), [Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted, {{"Weekday", type text}, {"Hour", Int64.Type}, {"Time_of_day", type text}, {"Calendar_month", type text}, {"Police_force", type text}, {"Nation", type text}, {"Severity", type text}, {"Road_class", type text}, {"Road_type", type text}, {"Speed_limit", type text}, {"Light", type text}, {"Weather", type text}, {"Surface", type text}, {"Area", type text}, {"Force_lat", type number}, {"Force_lon", type number}, {"Collision_count", Int64.Type}, {"Casualty_count", Int64.Type}, {"Vehicle_count", Int64.Type}}, "en-US"),
				Dates0 = Table.TransformColumns(Typed, {{"Date", each if _ = null or _ = "" then null else Date.FromText(Text.From(_), [Culture="en-US", Format="yyyy-MM-dd"]), type date}}),
				AddMonth = Table.AddColumn(Dates0, "Month", each Date.StartOfMonth(DateTime.Date(Record.Field(_, "Date"))), type date),
				AddYear = Table.AddColumn(AddMonth, "Year", each Date.Year(Record.Field(_, "Month")), Int64.Type)
			in
