table TrafficVolume
	lineageTag: 907e0b98-2bf1-5761-a11a-a2620dcf271c

	measure 'Hours of data' = COUNTROWS(TrafficVolume)
		formatString: #,0
		lineageTag: 67d3fa03-98d6-5ee8-b439-04bb2dd2ac72

	measure 'Average traffic per hour' = AVERAGE(TrafficVolume[Traffic_volume])
		formatString: #,0
		lineageTag: 6e15fffc-8d53-5248-899c-18d65a93a4b2

	measure 'Total vehicles' = SUM(TrafficVolume[Traffic_volume])
		formatString: #,0
		lineageTag: 84df0b88-7ded-5009-8479-ac282901bac4

	measure 'Average temperature' = AVERAGE(TrafficVolume[Temperature_C])
		formatString: 0.0
		lineageTag: 6ccee754-d5d7-5e3f-8cf3-18b8f135e730

	measure 'Busiest hour' = MAX(TrafficVolume[Traffic_volume])
		formatString: #,0
		lineageTag: 0a6b1207-34a3-5937-a970-e6e624a9553b

	measure 'Rainy hours share' = DIVIDE(CALCULATE(COUNTROWS(TrafficVolume), TrafficVolume[Rain_mm] > 0), COUNTROWS(TrafficVolume))
		formatString: 0.0%
		lineageTag: a7cbc963-b50d-5072-a6a6-47b41b2a4d16

	column Date
		dataType: dateTime
		formatString: Short Date
