		formatString: 0
		lineageTag: 29d07a53-98d5-5799-821c-ec021a35d8f0

	measure 'Rainy hours share' = DIVIDE(CALCULATE(COUNTROWS(SeoulBikes), SeoulBikes[Rainfall_mm] > 0), COUNTROWS(SeoulBikes))
