				Typed = Table.TransformColumnTypes(Promoted, {{"Rented_Bike_Count", Int64.Type}, {"Hour", Int64.Type}, {"Temperature_C", type number}, {"Humidity_pct", Int64.Type}, {"Wind_speed_ms", type number}, {"Visibility_10m", Int64.Type}, {"Dew_point_C", type number}, {"Solar_radiation_MJ_m2", type number}, {"Rainfall_mm", type number}, {"Snowfall_cm", type number}, {"Seasons", type text}, {"Holiday", type text}, {"Functioning_Day", type text}}, "en-US"),
