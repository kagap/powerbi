                      "fontWeight": "bold",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "UCI Machine Learning Repository, Seoul Bike Sharing Demand (Seoul Metropolitan Government and Data.go.kr; E and Park, 2020), licence CC BY 4.0. https://archive.ics.uci.edu/dataset/560. Column names were cleaned.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rows = COUNTROWS(SeoulBikes)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Total rentals = SUM(SeoulBikes[Rented_Bike_Count])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average rentals per hour = AVERAGE(SeoulBikes[Rented_Bike_Count])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average temperature = AVERAGE(SeoulBikes[Temperature_C])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average humidity = AVERAGE(SeoulBikes[Humidity_pct])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rainy hours share = DIVIDE(CALCULATE(COUNTROWS(SeoulBikes), SeoulBikes[Rainfall_mm] > 0), COUNTROWS(SeoulBikes))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              }
            ]
          }
