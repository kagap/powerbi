table HospitalReadmission
	lineageTag: ad950097-19ea-5818-856b-fba5bf9cf6cc

	measure Patients = COUNTROWS(HospitalReadmission)
		formatString: #,0
		lineageTag: ff8c2f1c-c950-516a-9f49-b55c0955e42f

	measure 'Readmitted within 30 days' = DIVIDE(CALCULATE(COUNTROWS(HospitalReadmission), HospitalReadmission[Readmitted] = "3 Within 30 days"), COUNTROWS(HospitalReadmission))
		formatString: 0.0%
		lineageTag: 6b8caf9a-51c5-563b-8946-8aec4e6659d1

	measure 'Average days in hospital' = AVERAGE(HospitalReadmission[TimeInHospital])
		formatString: 0.0
		lineageTag: b3a7b711-036c-5ed3-b032-a9f2a14ec9ea

	measure 'Average medications' = AVERAGE(HospitalReadmission[Medications])
		formatString: 0.0
		lineageTag: ab8b2f86-0f1d-52ed-b21f-182f5be1ca85

	measure 'Average prior inpatient visits' = AVERAGE(HospitalReadmission[PriorInpatient])
		formatString: 0.00
		lineageTag: 769dd7fc-765a-51e6-8e14-8dbabe1d41cc

	measure 'Total days in hospital' = SUM(HospitalReadmission[TimeInHospital])
		formatString: #,0
		lineageTag: 1c19ab96-7a76-57e3-86ef-511f3a412748

