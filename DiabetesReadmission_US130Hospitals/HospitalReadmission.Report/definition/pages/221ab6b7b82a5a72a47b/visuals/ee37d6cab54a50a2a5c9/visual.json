      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "69,970 first hospital stays of patients with diabetes in 130 US hospitals between 1999 and 2008: age, sex, race, how the patient was admitted, the main diagnosis, length of stay, tests and medications, and whether the patient came back to hospital (never, after 30 days or within 30 days).",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Open the Filters pane on the right (the funnel tab) to filter by category or date; the selection applies to every page. Click a bar, a slice or a point to cross-filter the other charts, and hover over one to see a small summary card.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data source",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "UCI Machine Learning Repository, Diabetes 130-US hospitals for years 1999-2008 (Strack et al., 2014), licence CC BY 4.0. https://archive.ics.uci.edu/dataset/296. Prepared: only the first stay of each patient was kept (101,766 stays became 71,518), patients who died or went to hospice were removed because they cannot be readmitted (69,973 left), three stays with an unknown sex were dropped (69,970), 10 stays without a diagnosis code are counted under Other, a missing race is labelled Unknown, ICD-9 diagnosis codes were grouped into the nine groups of the original paper, and codes for admission and discharge were replaced by their names.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Patients = COUNTROWS(HospitalReadmission)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Readmitted within 30 days = DIVIDE(CALCULATE(COUNTROWS(HospitalReadmission), HospitalReadmission[Readmitted] = \"3 Within 30 days\"), COUNTROWS(HospitalReadmission))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average days in hospital = AVERAGE(HospitalReadmission[TimeInHospital])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average medications = AVERAGE(HospitalReadmission[Medications])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average prior inpatient visits = AVERAGE(HospitalReadmission[PriorInpatient])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Total days in hospital = SUM(HospitalReadmission[TimeInHospital])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1F2A24"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
