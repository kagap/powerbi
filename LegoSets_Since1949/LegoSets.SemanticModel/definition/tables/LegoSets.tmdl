table LegoSets
	lineageTag: d6658188-a606-57f1-957c-e598e66a1c44

	measure Sets = COUNTROWS(LegoSets)
		formatString: #,0
		lineageTag: 5485e401-1ef0-57b8-bdff-b8e2429f65d6

	measure 'Total parts (millions)' = SUM(LegoSets[Parts]) / 1000000
		formatString: #,0.0
		lineageTag: 24ba5c90-7e21-5009-8f2d-3183bb0321b2

	measure 'Average parts per set' = AVERAGE(LegoSets[Parts])
		formatString: #,0
		lineageTag: adf80347-4916-5112-a12e-6555c8d63c11

	measure 'Median parts per set' = MEDIAN(LegoSets[Parts])
		formatString: #,0
		lineageTag: a014461c-8adf-527f-bbc6-df44403e1c42

	measure 'Largest set (parts)' = MAX(LegoSets[Parts])
		formatString: #,0
		lineageTag: e5e0315c-6aee-597e-8796-e3c3482a4828

	measure Themes = DISTINCTCOUNT(LegoSets[Root_theme])
		formatString: #,0
		lineageTag: b68e2bbb-a458-5050-9e5a-b11b22efd026

	measure 'Sets with 1,000 parts or more' = CALCULATE(COUNTROWS(LegoSets), LegoSets[Parts] >= 1000)
		formatString: #,0
		lineageTag: 8fbb7ae6-12e0-5727-b638-212b66bfe6e5

	measure 'Share of sets with 1,000 parts or more' = DIVIDE(CALCULATE(COUNTROWS(LegoSets), LegoSets[Parts] >= 1000), COUNT(LegoSets[Parts]))
		formatString: 0.0%
		lineageTag: 70c91c32-aa1c-547c-9132-73b9caf058e7

	measure 'Sets with a parts count' = COUNT(LegoSets[Parts])
		formatString: #,0
		lineageTag: 30d199fc-7112-5656-a481-2501bc747232

	measure 'First year' = MIN(LegoSets[Year])
		formatString: 0
		lineageTag: 478b2b7a-6d1c-56d4-95e5-beaddf423799

	column Set_number
		dataType: string
		lineageTag: 61378d51-ef42-5b3d-9be0-c030e3bd3980
		summarizeBy: none
		sourceColumn: "Set_number"

	column Set_name
		dataType: string
		lineageTag: 4b737201-c0e0-56b2-a6df-1df3868f7bed
		summarizeBy: none
		sourceColumn: "Set_name"

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 2ad64a84-a75b-50c2-bcd6-094fb1781f52
		summarizeBy: none
		sourceColumn: "Year"

	column Decade
		dataType: string
		lineageTag: 20a870cb-f9dd-553a-866a-2a56b9cc59e8
		summarizeBy: none
		sourceColumn: "Decade"

	column Root_theme
		dataType: string
		lineageTag: 37f0ad8f-9257-5369-840c-fa1a2ea7552c
		summarizeBy: none
		sourceColumn: "Root_theme"

	column Theme
