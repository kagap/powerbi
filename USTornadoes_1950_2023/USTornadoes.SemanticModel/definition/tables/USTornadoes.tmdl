table USTornadoes
	lineageTag: 368b7a70-02ab-5d66-92c5-0133c0059206

	measure Tornadoes = COUNTROWS(USTornadoes)
		formatString: #,0
		lineageTag: 4710085a-e7ed-5b6d-8255-cffc09db75c6

	measure Deaths = SUM(USTornadoes[Fatalities])
		formatString: #,0
		lineageTag: a55a1eb5-2b03-5f86-a85d-8af4bea6865d

	measure 'Total injuries' = SUM(USTornadoes[Injuries])
		formatString: #,0
		lineageTag: 45d5e742-a002-51d7-bbcc-d003ea0f5b8a

	measure 'Average path length (mi)' = AVERAGE(USTornadoes[Length_miles])
		formatString: 0.0
		lineageTag: bdc92ab7-63d0-519f-ae78-7c9ba43f94fa

	measure 'Violent tornadoes (EF4-5)' = CALCULATE(COUNTROWS(USTornadoes), USTornadoes[Strength] = "3 Violent (EF4-5)")
		formatString: #,0
		lineageTag: 5b6d7fe2-2547-5ab9-9c39-3bafd81fb635

	measure 'Deadly tornado share' = DIVIDE(CALCULATE(COUNTROWS(USTornadoes), USTornadoes[Fatalities] > 0), COUNTROWS(USTornadoes))
		formatString: 0.0%
		lineageTag: a7b6cf09-e207-54a1-9679-bfb1de6f450f

	measure 'Average path width (yd)' = AVERAGE(USTornadoes[Width_yards])
		formatString: #,0
		lineageTag: 1e9c21d1-d671-57bf-a9aa-15448fadd043

	measure 'State tile' = SELECTEDVALUE(USTornadoes[State_code])
		formatString: General
		lineageTag: 7c6e1a76-8843-5c9e-98ed-9bee12f16a62

	column Tornado_id
		dataType: int64
		formatString: 0
		lineageTag: 99e3a970-68b9-5d78-974a-620423d2d627
		summarizeBy: none
		sourceColumn: "Tornado_id"

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: b1ffb87b-436a-5ff2-80a5-0b8af30d9e48
		summarizeBy: none
		sourceColumn: "Date"

