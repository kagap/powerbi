		summarizeBy: none
		sourceColumn: "Population"

	column Grid_row
		dataType: int64
		formatString: 0
		lineageTag: ae1a8efd-9464-5ee1-9c00-f1f391fe6bad
		summarizeBy: none
		sourceColumn: "Grid_row"

