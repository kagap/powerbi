table USPopulation
	lineageTag: 028b39a5-068a-5b5f-86b2-65c320324fdf

	measure Records = COUNTROWS(USPopulation)
		formatString: #,0
		lineageTag: a3b77c49-6442-5c9b-9fa2-e083f49f5f6b

	measure Residents = CALCULATE(SUM(USPopulation[Population]), USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year]))
		formatString: #,0
		lineageTag: fd9f2d26-9fa9-5d60-b19e-c9dbf4c3aac9

	measure Women = CALCULATE(SUM(USPopulation[Population]), USPopulation[Sex] = "Female", USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year]))
		formatString: #,0
		lineageTag: 74f89a33-c705-5e9b-806d-d3da8519a833

	measure Men = CALCULATE(SUM(USPopulation[Population]), USPopulation[Sex] = "Male", USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year]))
		formatString: #,0
		lineageTag: 74fb22ad-1da6-5ca2-8a0f-c39d54606cea

	measure 'Men (mirrored)' = -CALCULATE(SUM(USPopulation[Population]), USPopulation[Sex] = "Male", USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year]))
		formatString: #,0;#,0
		lineageTag: 9be0b0e1-ba5b-5431-9705-1a48d233c4bd

	measure 'Average age' = DIVIDE(CALCULATE(SUMX(USPopulation, USPopulation[Age] * USPopulation[Population]), USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])), CALCULATE(SUM(USPopulation[Population]), USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])))
		formatString: 0.0
		lineageTag: 513bc700-1a6c-5aa4-8888-eea820cc21d5

	measure 'Share 65 and over' = DIVIDE(CALCULATE(SUM(USPopulation[Population]), USPopulation[Age] >= 65, USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])), CALCULATE(SUM(USPopulation[Population]), USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])))
		formatString: 0.0%
		lineageTag: 6ab242fb-ea1c-5e5e-8d4f-12b496c6b4d4

	measure 'Share under 15' = DIVIDE(CALCULATE(SUM(USPopulation[Population]), USPopulation[Age] < 15, USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])), CALCULATE(SUM(USPopulation[Population]), USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])))
		formatString: 0.0%
		lineageTag: 8fcaf710-9bc3-5f67-af15-e850eec58429

	measure 'Women per 100 men' = DIVIDE(CALCULATE(SUM(USPopulation[Population]), USPopulation[Sex] = "Female", USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])), CALCULATE(SUM(USPopulation[Population]), USPopulation[Sex] = "Male", USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year]))) * 100
		formatString: 0.0
		lineageTag: 9bebf014-b905-56f0-8e17-4c49c3a45a7a

	measure 'Dependants per 100 of working age' = DIVIDE(CALCULATE(SUM(USPopulation[Population]), USPopulation[Age] < 15, USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])) + CALCULATE(SUM(USPopulation[Population]), USPopulation[Age] >= 65, USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year])), CALCULATE(SUM(USPopulation[Population]), USPopulation[Age] >= 15, USPopulation[Age] < 65, USPopulation[Estimate_year] = MAX(USPopulation[Estimate_year]))) * 100
		formatString: 0
		lineageTag: d1f90b03-5cda-5f41-9608-18cd88c927ce

	measure 'State tile' = SELECTEDVALUE(USPopulation[State_code])
		formatString: General
		lineageTag: 436dc27d-2ee4-5f14-8672-3493bd476530

	measure 'Change 2020 to 2024' = CALCULATE(SUM(USPopulation[Population]), USPopulation[Estimate_year] = 2024) - CALCULATE(SUM(USPopulation[Population]), USPopulation[Estimate_year] = 2020)
		formatString: +#,0;-#,0;0
		lineageTag: da8b979a-f75a-52cf-882b-7b89506aea09

	column Estimate_year
		dataType: int64
		formatString: 0
		lineageTag: 6afde61c-1930-5f99-9487-1774e036e2ad
		summarizeBy: none
		sourceColumn: "Estimate_year"

	column State
