table BeijingPM25
	lineageTag: dbbb0c3f-f03b-5b3c-99cb-f7baa98b5571

	measure 'Hours of data' = COUNTROWS(BeijingPM25)
		formatString: #,0
		lineageTag: bc0e1a63-9863-5253-a09d-bf3a11f2438a

	measure 'Average PM2.5' = AVERAGE(BeijingPM25[PM25])
		formatString: 0
		lineageTag: 4cf1241b-7ed9-59fc-a1cb-5d17438bf7cc

	measure 'Share of hours above 55' = DIVIDE(CALCULATE(COUNTROWS(BeijingPM25), BeijingPM25[PM25] > 55.4), CALCULATE(COUNTROWS(BeijingPM25), NOT(ISBLANK(BeijingPM25[PM25]))))
		formatString: 0.0%
		lineageTag: d186a47c-5cd7-53e8-a33b-71f6177b0073

	measure 'Average temperature' = AVERAGE(BeijingPM25[Temperature_C])
