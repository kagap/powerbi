table NYC311
	lineageTag: c6c0e028-e61d-5ef2-bed2-3d081f246c8e

	measure Requests = COUNTROWS(NYC311)
		formatString: #,0
		lineageTag: 8feeeed3-959b-55b5-aba5-7bbd284d1dd9

	measure Closed = CALCULATE(COUNTROWS(NYC311), NYC311[Status] = "Closed")
		formatString: #,0
		lineageTag: e583da64-76be-5d89-af3e-72adfafa4cee

	measure 'Closure rate' = DIVIDE(CALCULATE(COUNTROWS(NYC311), NYC311[Status] = "Closed"), COUNTROWS(NYC311))
		formatString: 0.0%
		lineageTag: d0d6d68b-bca5-53b7-a0c1-204c820cd406

	measure 'Closed within 3 days' = COUNTROWS(FILTER(NYC311, NOT ISBLANK(NYC311[Days_to_close]) && NYC311[Days_to_close] <= 3))
		formatString: #,0
		lineageTag: bad5d56a-ce25-5cbc-8f81-d92dce7efd8a

	measure 'Share closed within 3 days' = DIVIDE(COUNTROWS(FILTER(NYC311, NOT ISBLANK(NYC311[Days_to_close]) && NYC311[Days_to_close] <= 3)), COUNTROWS(NYC311))
		formatString: 0.0%
		lineageTag: 5e37aeeb-b6f5-5b7f-bfaf-84aa986afa1a

	measure 'Median days to close' = MEDIAN(NYC311[Days_to_close])
		formatString: 0.0
		lineageTag: b79d681a-5491-5689-8c52-70b498804e93

	measure 'Average days to close' = AVERAGE(NYC311[Days_to_close])
		formatString: 0.0
		lineageTag: cbf0e814-38aa-5d67-b468-e2bbef12c59c

	measure 'Not closed' = CALCULATE(COUNTROWS(NYC311), NYC311[Status] <> "Closed")
		formatString: #,0
		lineageTag: 000d67b3-1d73-551a-8107-29e01b3cf339

	measure Agencies = DISTINCTCOUNT(NYC311[Agency_code])
		formatString: #,0
		lineageTag: 733a9d29-3c56-57c0-ab43-cfe948c5c282

	measure 'Complaint types' = DISTINCTCOUNT(NYC311[Complaint_type])
		formatString: #,0
		lineageTag: 704b519f-8067-571b-aa17-32c28e1b7c36

