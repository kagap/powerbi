					""}), BinaryEncoding.Base64), Compression.GZip), [Delimiter=",", Columns=39, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted, {{"Country", type text}, {"ISO3", type text}, {"Subregion", type text}, {"Region", type text}, {"Period", type text}, {"Decade", type text}, {"Population_thousands", type number}, {"Population_jan_thousands", type number}, {"Male_thousands", type number}, {"Female_thousands", type number}, {"Density_per_km2", type number}, {"Median_age", type number}, {"Pop_change_thousands", type number}, {"Births_thousands", type number}, {"Deaths_thousands", type number}, {"Fertility", type number}, {"Life_expectancy", type number}, {"Life_exp_male", type number}, {"Life_exp_female", type number}, {"Infant_mortality", type number}, {"Under5_mortality", type number}, {"Net_migration_thousands", type number}, {"World_fertility", type number}, {"Region_fertility", type number}, {"Subregion_fertility", type number}, {"World_life_expectancy", type number}, {"Region_life_expectancy", type number}, {"Subregion_life_expectancy", type number}, {"World_median_age", type number}, {"Region_median_age", type number}, {"Subregion_median_age", type number}, {"World_infant_mortality", type number}, {"Region_infant_mortality", type number}, {"Subregion_infant_mortality", type number}, {"Fertility_band", type text}, {"Life_band", type text}, {"Age_band", type text}, {"Size_band", type text}}, "en-US"),
				Dates0 = Table.TransformColumns(Typed, {{"Date", each if _ = null or _ = "" then null else Date.FromText(Text.From(_), [Culture="en-US", Format="yyyy-MM-dd"]), type date}}),
				AddMonth = Table.AddColumn(Dates0, "Month", each Date.StartOfMonth(DateTime.Date(Record.Field(_, "Date"))), type date),
				AddYear = Table.AddColumn(AddMonth, "Year", each Date.Year(Record.Field(_, "Month")), Int64.Type)
			in
