table WorldDemography
	lineageTag: 7eb218f2-1442-5ce7-9fd4-5023cb2c85a9

	measure 'Country-years' = COUNTROWS(WorldDemography)
		formatString: #,0
		lineageTag: 51103d7a-4f68-524a-a972-a96dd34b3b27

	measure 'Population (millions)' = SUM(WorldDemography[Population_thousands]) / 1000
		formatString: #,0
		lineageTag: 82977b1b-89f5-50b5-a429-fd1747839445

	measure 'Population 2023 (millions)' = CALCULATE(SUM(WorldDemography[Population_thousands]), WorldDemography[Year] = 2023) / 1000
		formatString: #,0
		lineageTag: 129b43e7-ca80-533a-b9f0-8a09bf55ed9e

	measure 'Population 2100 (millions)' = CALCULATE(SUM(WorldDemography[Population_thousands]), WorldDemography[Year] = 2100) / 1000
		formatString: #,0
		lineageTag: 413cdc05-376d-52ca-b8b7-d8b30f8f9a24

	measure 'Change 2023 to 2100' = DIVIDE(CALCULATE(SUM(WorldDemography[Population_thousands]), WorldDemography[Year] = 2100), CALCULATE(SUM(WorldDemography[Population_thousands]), WorldDemography[Year] = 2023)) - 1
		formatString: +0%;-0%;0%
		lineageTag: d4cfec16-124b-5a75-9651-453d04105f45

	measure 'World fertility' = AVERAGE(WorldDemography[World_fertility])
		formatString: 0.00
		lineageTag: 7b66d37f-2006-5672-9495-72db456ce72f

	measure 'World life expectancy' = AVERAGE(WorldDemography[World_life_expectancy])
		formatString: 0.0
		lineageTag: 0ade9a3d-1748-55e9-86a2-15f8dc1e3894

	measure 'World median age' = AVERAGE(WorldDemography[World_median_age])
		formatString: 0.0
		lineageTag: 9045d1de-a7ae-536d-8afc-8543ed9e3abf

	measure 'Region fertility' = AVERAGE(WorldDemography[Region_fertility])
		formatString: 0.00
		lineageTag: e7e4ed65-db2a-586c-913d-f784a0590ab6

	measure 'Region life expectancy' = AVERAGE(WorldDemography[Region_life_expectancy])
		formatString: 0.0
		lineageTag: 16acf8f8-a933-5fc6-8456-fdc2a9b87238

	measure 'Region median age' = AVERAGE(WorldDemography[Region_median_age])
		formatString: 0.0
		lineageTag: 62994052-b18f-5832-94d7-becfd038ae35

	measure 'Subregion median age' = AVERAGE(WorldDemography[Subregion_median_age])
		formatString: 0.0
		lineageTag: 259b0408-5f81-551f-94c3-22f81b585019

	measure 'Country fertility' = AVERAGE(WorldDemography[Fertility])
		formatString: 0.00
		lineageTag: d18455d2-502f-5e9c-afcb-9db176d64f23

	measure 'Country life expectancy' = AVERAGE(WorldDemography[Life_expectancy])
		formatString: 0.0
		lineageTag: 5694f3d8-171f-5f91-b11f-493452da235b

	measure 'Births (millions)' = SUM(WorldDemography[Births_thousands]) / 1000
		formatString: #,0.0
		lineageTag: 37696dc2-70d9-586a-a07e-4ab4f740b2f3

	measure 'Deaths (millions)' = SUM(WorldDemography[Deaths_thousands]) / 1000
		formatString: #,0.0
		lineageTag: d7b36770-c182-5fe3-94a2-d655f3d84c31

	measure 'World infant mortality' = AVERAGE(WorldDemography[World_infant_mortality])
		formatString: 0.0
		lineageTag: 577ddbe6-be4a-511f-856e-a4088b0ed294

	measure 'Region infant mortality' = AVERAGE(WorldDemography[Region_infant_mortality])
		formatString: 0.0
		lineageTag: a68bb87c-1eb1-581d-bc46-a3fe7c7987e6

	measure Countries = DISTINCTCOUNT(WorldDemography[Country])
		formatString: #,0
		lineageTag: cb3514f3-2c6d-51f5-a040-e5322719f5cf

	measure 'Life expectancy 2023' = CALCULATE(AVERAGE(WorldDemography[World_life_expectancy]), WorldDemography[Year] = 2023)
		formatString: 0.0
		lineageTag: 5e65219e-a0a8-54fc-b102-a10aadc3668d

	measure 'Fertility 2023' = CALCULATE(AVERAGE(WorldDemography[World_fertility]), WorldDemography[Year] = 2023)
		formatString: 0.00
		lineageTag: dfdb1b54-bfb2-540a-9bec-d7032f131284

	measure 'Median age 2023' = CALCULATE(AVERAGE(WorldDemography[World_median_age]), WorldDemography[Year] = 2023)
		formatString: 0.0
		lineageTag: 33918385-379a-5b78-ba47-ae63340b655d

	measure 'Median age 2100' = CALCULATE(AVERAGE(WorldDemography[World_median_age]), WorldDemography[Year] = 2100)
