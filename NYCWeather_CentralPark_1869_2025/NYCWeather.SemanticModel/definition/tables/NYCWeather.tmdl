table NYCWeather
	lineageTag: bc919eb7-0a3c-56e2-a028-7b15103682a7

	measure Days = COUNTROWS(NYCWeather)
		formatString: #,0
		lineageTag: 27f68a24-cecd-5d40-8368-5e494d62ec43

	measure 'Average temperature (C)' = AVERAGE(NYCWeather[TAVG_C])
		formatString: 0.0
		lineageTag: 402a2950-1183-5d75-a4f2-dd80b24bd4b4

	measure 'Anomaly vs 1869-1900 (C)' = AVERAGE(NYCWeather[TAVG_C]) - CALCULATE(AVERAGE(NYCWeather[TAVG_C]), REMOVEFILTERS(NYCWeather[Year]), REMOVEFILTERS(NYCWeather[Decade]), REMOVEFILTERS(NYCWeather[Period]), NYCWeather[Period] = "1 1869-1900")
		formatString: +0.0;-0.0;0.0
		lineageTag: 4cac15fc-01aa-55f3-9be6-9a7b4ebd5d39

	measure 'Average daily high (C)' = AVERAGE(NYCWeather[TMAX_C])
		formatString: 0.0
		lineageTag: c533567a-e3d9-5b87-93cd-a4b3ab3fa44e

	measure 'Average daily low (C)' = AVERAGE(NYCWeather[TMIN_C])
		formatString: 0.0
		lineageTag: 42784a9b-9af5-5a5c-8359-407509b0e5bd

	measure 'Precipitation (mm)' = SUM(NYCWeather[PRCP_mm])
		formatString: #,0
		lineageTag: ec7bf96b-a9d4-5f27-84fd-0eb80a5725f6

	measure 'Snowfall (cm)' = SUM(NYCWeather[SNOW_mm]) / 10
		formatString: #,0
		lineageTag: ba40acb5-46cf-5c4e-a600-dd4f9826ce1a

	measure 'Days with a high of 32 C or more' = CALCULATE(COUNTROWS(NYCWeather), NYCWeather[TMAX_C] >= 32)
		formatString: #,0
		lineageTag: c81738eb-2797-5ea3-a989-8c24ed674da3

	measure 'Days that never thawed' = CALCULATE(COUNTROWS(NYCWeather), NYCWeather[TMAX_C] < 0)
		formatString: #,0
		lineageTag: 557a85fe-5dcf-53b9-94ff-ca4675f84f8e

	measure 'Record high (C)' = MAX(NYCWeather[TMAX_C])
		formatString: 0.0
		lineageTag: 6301dbe3-39ef-53fc-8939-376c2e0429e7

	measure 'Record low (C)' = MIN(NYCWeather[TMIN_C])
		formatString: 0.0
		lineageTag: 7b151e84-ac9a-548e-848b-598672a1ba73

	measure Stripe = 1
		formatString: 0
		lineageTag: 220b3595-01ab-5533-88bd-2f60b5d64325

	measure 'Wet days (1 mm or more)' = CALCULATE(COUNTROWS(NYCWeather), NYCWeather[PRCP_mm] >= 1)
		formatString: #,0
		lineageTag: fd21e1ff-fa9b-5ef3-a83d-c77618ed2048

