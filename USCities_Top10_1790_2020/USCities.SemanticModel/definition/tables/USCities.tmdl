table USCities
	lineageTag: 92e6fed8-c16b-5c05-aefb-f991128b568b

	measure Entries = COUNTROWS(USCities)
		formatString: #,0
		lineageTag: e9232d93-9cc7-51eb-b450-4d1d0ffa15e7

	measure 'Rank (1 is the largest)' = -MIN(USCities[Rank])
		formatString: #,0;#,0
		lineageTag: 531d13ed-2081-54d3-b9df-d04ea8552493

	measure Residents = SUM(USCities[Population])
		formatString: #,0
		lineageTag: 1ed39b07-a54f-54d2-8ac6-6ce50763567d

	measure 'Average rank' = AVERAGE(USCities[Rank])
		formatString: 0.0
		lineageTag: 5de7d151-53f8-5f38-89d0-f31048c0e19c

	measure 'Best rank' = MIN(USCities[Rank])
		formatString: 0
		lineageTag: f980530c-f250-5d14-af67-976f4aa3e072

	measure 'Censuses in the top 10' = DISTINCTCOUNT(USCities[Census_year])
		formatString: 0
		lineageTag: 37c69ef6-0858-5d28-90a2-385b19792520

	measure 'Rank change vs previous census' = SUM(USCities[Rank_change])
		formatString: +0;-0;0
		lineageTag: a28678e9-53a1-5657-9089-0d9357ad7e10

	measure 'Growth vs previous census (%)' = AVERAGE(USCities[Population_growth_pct])
		formatString: 0.0
		lineageTag: 26895419-49da-50f8-b3e9-f4fb61b5383c

	measure Cities = DISTINCTCOUNT(USCities[City])
		formatString: 0
		lineageTag: 8e361c20-2d4a-5521-912a-1f99dc6b8ab3

	measure 'Rank score (11 minus rank)' = 11 - MIN(USCities[Rank])
		formatString: 0
		lineageTag: 60a85d49-48f9-559c-b565-ab104bce8ed1

	measure 'Largest city (people)' = MAX(USCities[Population])
		formatString: #,0
		lineageTag: 975ba015-aecf-5afa-8919-3fb33dd30a06

	measure 'Rank in the census' = MIN(USCities[Rank])
		formatString: 0
		lineageTag: 0e282917-5430-5c0c-9340-32a44b33a302

