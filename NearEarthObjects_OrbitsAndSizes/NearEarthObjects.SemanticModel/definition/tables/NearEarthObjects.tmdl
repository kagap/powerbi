table NearEarthObjects
	lineageTag: dcff6c82-c5a0-56b2-81df-2114de27c9a7

	measure Objects = COUNTROWS(NearEarthObjects)
		formatString: #,0
		lineageTag: b1d59213-073b-58c9-a7a4-bc7c092fd529

	measure 'Potentially hazardous' = CALCULATE(COUNTROWS(NearEarthObjects), NearEarthObjects[Hazard] = "Potentially hazardous")
		formatString: #,0
		lineageTag: 064c9a93-08b9-5db2-9d7d-8cab848d2397

	measure 'Share potentially hazardous' = DIVIDE(CALCULATE(COUNTROWS(NearEarthObjects), NearEarthObjects[Hazard] = "Potentially hazardous"), COUNTROWS(NearEarthObjects))
		formatString: 0.0%
		lineageTag: a540186e-fcf1-5679-97aa-15bb0f98070b

	measure 'Larger than 1 km' = CALCULATE(COUNTROWS(NearEarthObjects), NearEarthObjects[Size_m] >= 1000)
		formatString: #,0
		lineageTag: 148bd644-bbcb-52b2-b067-40f2ca627f1f

	measure 'Median size (m)' = MEDIAN(NearEarthObjects[Size_m])
		formatString: #,0
		lineageTag: 6303e89e-b8df-54a7-8ca2-f77e63dd052f

	measure 'Average eccentricity' = AVERAGE(NearEarthObjects[Eccentricity])
		formatString: 0.00
		lineageTag: 0aa586fd-0424-5912-9a2a-a4424728f9f8

	measure 'Average inclination (degrees)' = AVERAGE(NearEarthObjects[Inclination_deg])
		formatString: 0.0
		lineageTag: ac461c3b-59cb-5512-963e-f1a6e7645165

	measure 'Average semi-major axis (AU)' = AVERAGE(NearEarthObjects[Semi_major_axis_au])
		formatString: 0.00
		lineageTag: 5dc89e73-6d4c-5fd8-b480-191f294ca2f5

	measure 'Cell semi-major axis' = AVERAGE(NearEarthObjects[Cell_a])
		formatString: 0.00
		lineageTag: 0f04b821-6686-55e8-bce1-5e4b243e552f

	measure 'Cell eccentricity' = AVERAGE(NearEarthObjects[Cell_e])
		formatString: 0.00
		lineageTag: 3af70a65-60c2-59ba-b8e6-f3c6ada7fd57

	measure 'Closest orbit gap (lunar distances)' = MIN(NearEarthObjects[Earth_moid_ld])
		formatString: 0.0
		lineageTag: 61883a6d-edda-5ed0-8a11-ad2db0f41508

	measure 'First seen' = MIN(NearEarthObjects[Discovery_year])
		formatString: 0
		lineageTag: ed4a124b-73f6-596b-b496-3b901d3a8cbd

