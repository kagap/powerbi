          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "32,561 adults from the 1994 US census extract. One row per person: age, work class, education, marital status, occupation, race, sex, capital gains and losses, hours worked per week, country, and whether income is above 50,000 dollars a year. Missing values (marked ? in the source) are left empty.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Open the Filters pane on the right (the funnel tab) to filter by category or date; the selection applies to every page. Click a bar, a slice or a point to cross-filter the other charts, and hover over one to see a small summary card.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data source",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "UCI Machine Learning Repository, Adult (Census Income) dataset (Becker and Kohavi, 1996), licence CC BY 4.0. https://archive.ics.uci.edu/dataset/2. The fnlwgt column was dropped.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rows = COUNTROWS(AdultIncome)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "High-income share = DIVIDE(CALCULATE(COUNTROWS(AdultIncome), AdultIncome[income] = \">50K\"), COUNTROWS(AdultIncome))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average age = AVERAGE(AdultIncome[age])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average hours per week = AVERAGE(AdultIncome[hours_per_week])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average education years = AVERAGE(AdultIncome[education_num])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Capital gain per person = DIVIDE(SUM(AdultIncome[capital_gain]), COUNTROWS(AdultIncome))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#2D3748"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
