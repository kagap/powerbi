table AdultIncome
	lineageTag: 93a8d7f3-1431-575b-a5bc-ab8bd21e6b98

	measure Rows = COUNTROWS(AdultIncome)
		formatString: #,0
		lineageTag: e3ca20a6-a126-5f2f-87a5-71ff6aeeff05

	measure 'High-income share' = DIVIDE(CALCULATE(COUNTROWS(AdultIncome), AdultIncome[income] = ">50K"), COUNTROWS(AdultIncome))
		formatString: 0.0%
		lineageTag: d3880f24-effe-502c-a1c0-8e084d0c1361

	measure 'Average age' = AVERAGE(AdultIncome[age])
		formatString: 0.0
		lineageTag: c2c3fe48-8ab7-59c0-9ab5-0124e3e03d3a

	measure 'Average hours per week' = AVERAGE(AdultIncome[hours_per_week])
		formatString: 0.0
		lineageTag: d2cd53f0-8642-56fa-90fc-41758b1d9e15

	measure 'Average education years' = AVERAGE(AdultIncome[education_num])
		formatString: 0.0
		lineageTag: acc244fa-da66-5408-a6f7-a7175203f0f7

	measure 'Capital gain per person' = DIVIDE(SUM(AdultIncome[capital_gain]), COUNTROWS(AdultIncome))
		formatString: #,0
		lineageTag: db9786a0-b538-54ea-9252-c74c8b49a13f

