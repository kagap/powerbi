table TourismEurope
	lineageTag: a04d6ca9-4f41-5fa3-80ab-4945a7476f61

	measure Records = COUNTROWS(TourismEurope)
		formatString: #,0
		lineageTag: ec176f9d-a837-5109-9ed2-d0ea85c9cf3d

	measure 'Nights a year (millions)' = SUM(TourismEurope[Nights]) / DISTINCTCOUNT(TourismEurope[Year]) / 1000000
		formatString: #,0
		lineageTag: 7a7b6183-26eb-52d0-82b7-009f9f9b2ed3

	measure 'Foreign share' = DIVIDE(CALCULATE(SUM(TourismEurope[Nights]), TourismEurope[Guests] = "Foreign guests"), SUM(TourismEurope[Nights]))
		formatString: 0.0%
		lineageTag: 5e5a5bf0-ce48-571c-afcb-5a15e705fc77

	measure 'Summer share' = DIVIDE(CALCULATE(SUM(TourismEurope[Nights]), TourismEurope[Season] = "3 Summer"), SUM(TourismEurope[Nights]))
		formatString: 0.0%
		lineageTag: e25897c1-adca-586b-ab46-e97db2181234

	measure 'Share of the 2019 level' = DIVIDE(SUM(TourismEurope[Nights_comparable]), SUM(TourismEurope[Nights_2019_same_month]))
		formatString: 0.0%
		lineageTag: 70f857a6-6362-53e2-85f6-e4be1bb9dbe0

	measure Countries = DISTINCTCOUNT(TourismEurope[Country_code])
		formatString: #,0
		lineageTag: 2b5ef2f3-0fe1-54c9-9456-c2770b48438a

	measure 'Domestic nights a year (millions)' = CALCULATE(SUM(TourismEurope[Nights]), TourismEurope[Guests] = "Domestic guests") / DISTINCTCOUNT(TourismEurope[Year]) / 1000000
		formatString: #,0
		lineageTag: 94ab2d3f-8c0a-5353-ac52-769eb55e3930

	measure 'Foreign nights a year (millions)' = CALCULATE(SUM(TourismEurope[Nights]), TourismEurope[Guests] = "Foreign guests") / DISTINCTCOUNT(TourismEurope[Year]) / 1000000
		formatString: #,0
		lineageTag: a563e5d6-ae7a-5deb-962d-7a4f28b87823

	measure 'Hotels share' = DIVIDE(CALCULATE(SUM(TourismEurope[Nights]), TourismEurope[Accommodation] = "Hotels and similar"), SUM(TourismEurope[Nights]))
		formatString: 0.0%
		lineageTag: 565106ff-ce18-55e4-93d5-4e1a6c31e2d5

	measure 'Share of annual nights' = DIVIDE(SUM(TourismEurope[Nights]), CALCULATE(SUM(TourismEurope[Nights]), REMOVEFILTERS(TourismEurope[Month_name])))
		formatString: 0.0%
		lineageTag: f67aed53-b368-5214-89aa-741455f435cc

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: 7c65519c-1c75-5a1c-a1cd-10d803a6b18d
		summarizeBy: none
		sourceColumn: "Date"

	column Country
		dataType: string
		lineageTag: e872125b-31b7-5c60-9265-ac6751d2850f
		summarizeBy: none
		sourceColumn: "Country"

	column Country_code
		dataType: string
		lineageTag: ac185c54-4a9e-5e6c-97f3-6ca61567659a
		summarizeBy: none
		sourceColumn: "Country_code"

	column Region_group
		dataType: string
		lineageTag: ffbd6605-fe42-528c-875e-e4fd3185e436
		summarizeBy: none
		sourceColumn: "Region_group"

	column Guests
		dataType: string
		lineageTag: ae756c84-8103-59e2-8fb6-d31b81057f70
		summarizeBy: none
		sourceColumn: "Guests"

	column Accommodation
