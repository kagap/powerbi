	column Season
		dataType: string
		lineageTag: dba1ac59-2543-5950-b5ad-961fb2e2404c
		summarizeBy: none
		sourceColumn: "Season"

	column Era
		dataType: string
		lineageTag: fcd6cab4-191b-5a05-94de-4c7e7006b980
		summarizeBy: none
		sourceColumn: "Era"

	column Nights
		dataType: int64
		formatString: 0
		lineageTag: 98496e93-2326-5f0a-868c-4b0bd312cb48
		summarizeBy: none
		sourceColumn: "Nights"

	column Nights_2019_same_month
		dataType: double
		formatString: #,0.00
		lineageTag: f328a629-a8aa-5aa5-9130-447995d03027
		summarizeBy: none
		sourceColumn: "Nights_2019_same_month"

	column Nights_comparable
		dataType: int64
		formatString: 0
		lineageTag: 0ab031c3-c9f7-5578-87fc-b76c805d0441
		summarizeBy: none
		sourceColumn: "Nights_comparable"

	column Month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: d776980d-85ab-5f6e-98bd-c0470f006184
		summarizeBy: none
		sourceColumn: "Month"

	column Year
