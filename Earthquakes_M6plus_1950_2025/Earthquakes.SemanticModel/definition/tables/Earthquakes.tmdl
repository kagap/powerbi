table Earthquakes
	lineageTag: dc2cd176-92e0-5b46-8625-d0ff5e9e7218

	measure Earthquakes = COUNTROWS(Earthquakes)
		formatString: #,0
		lineageTag: a110882d-baf5-52c7-a914-fd68186d62c2

	measure 'Average magnitude' = AVERAGE(Earthquakes[Magnitude])
		formatString: 0.00
		lineageTag: ebce755a-02de-5c3b-b7f6-9ff326046830

	measure 'Largest magnitude' = MAX(Earthquakes[Magnitude])
		formatString: 0.0
		lineageTag: 0daf3d63-0e30-5ece-b328-52877220dc78

	measure 'Average depth (km)' = AVERAGE(Earthquakes[Depth_km])
		formatString: #,0
		lineageTag: a8de3bdb-2668-5aae-bcb7-3f07a3e9a4f8

	measure 'Magnitude 7 and over' = CALCULATE(COUNTROWS(Earthquakes), Earthquakes[Magnitude] >= 7)
		formatString: #,0
		lineageTag: 1e3d42a6-d921-56bc-ad58-da9bfb59d5b3

	measure 'Magnitude 8 and over' = CALCULATE(COUNTROWS(Earthquakes), Earthquakes[Magnitude] >= 8)
		formatString: #,0
		lineageTag: 27fb982e-9ea5-56d4-a6b4-9e132f327533

	measure 'Share deeper than 300 km' = DIVIDE(CALCULATE(COUNTROWS(Earthquakes), Earthquakes[Depth_km] >= 300), COUNTROWS(Earthquakes))
		formatString: 0.0%
		lineageTag: 99878a70-91f3-5b89-a4b2-ead75e23f069

	measure 'Share shallower than 70 km' = DIVIDE(CALCULATE(COUNTROWS(Earthquakes), Earthquakes[Depth_km] < 70), COUNTROWS(Earthquakes))
		formatString: 0.0%
		lineageTag: e320d7db-c22f-509b-9fd5-7208486a604e

	measure 'Cell longitude' = AVERAGE(Earthquakes[Cell_lon])
		formatString: 0
		lineageTag: bfc58fe1-d33a-56dd-8519-789ba7bddddf

	measure 'Cell latitude' = AVERAGE(Earthquakes[Cell_lat])
		formatString: 0
		lineageTag: 7fe67398-d707-5b4b-9f3a-ccf89afd3c49

	measure Regions = DISTINCTCOUNT(Earthquakes[Region])
		formatString: #,0
		lineageTag: a7067ed8-fb62-5ce4-b138-30972da67632

	measure 'Log10 of earthquakes' = LOG10(COUNTROWS(Earthquakes))
		formatString: 0.00
		lineageTag: eabf9b87-2ee4-5fe3-9eba-bc9c3689dc7a

