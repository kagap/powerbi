table UKGrid
	lineageTag: 766d6946-c731-58fa-b292-a3380a49426a

	measure 'Fuel records' = COUNTROWS(UKGrid)
		formatString: #,0
		lineageTag: b94b38d4-df93-5162-a0ef-5157fcea3a1f

	measure 'Half-hours' = DISTINCTCOUNT(UKGrid[Slot])
		formatString: #,0
		lineageTag: 765fdd5a-3877-5cc8-b9d7-319fba6d6aa1

	measure 'Average carbon intensity (g per kWh)' = AVERAGE(UKGrid[Intensity_actual])
		formatString: 0
		lineageTag: 17ae69af-52d4-5c91-b289-4ef23da8f99d

	measure 'Renewable share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Source_type] = "Renewable"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: c1422661-ce6f-58ba-863a-c6f4f1b2b8f2

	measure 'Low-carbon share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Source_type] = "Renewable" || UKGrid[Source_type] = "Nuclear" || UKGrid[Source_type] = "Biomass"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: 6ccad919-7d95-54e5-bdd1-149ccbdc5145

	measure 'Gas share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Fuel] = "Gas"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: 9bc3b6bd-23cc-5c46-ac43-f83671f03075

	measure 'Wind share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Fuel] = "Wind"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: 25b86fdd-26cb-5035-9cb0-0b5f93faea9c

	measure 'Solar share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Fuel] = "Solar"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: a9a38d28-4f6b-51ce-9962-c408c64a12e6

	measure 'Imports share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Fuel] = "Imports"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: 0eaa764f-8161-5317-8c56-72a5c2adf78c

	measure 'Nuclear share' = DIVIDE(CALCULATE(SUM(UKGrid[Share_pct]), UKGrid[Fuel] = "Nuclear"), SUM(UKGrid[Share_pct]))
		formatString: 0.0%
		lineageTag: e83bcc44-e945-51c2-b41a-c815aca912c0

	measure 'Cleanest half-hour (g per kWh)' = MIN(UKGrid[Intensity_actual])
		formatString: 0
		lineageTag: 52dc7aca-4605-51ab-bd68-4f2b00ffa6ea

	measure 'Dirtiest half-hour (g per kWh)' = MAX(UKGrid[Intensity_actual])
		formatString: 0
		lineageTag: 7aa8653b-74aa-5d8b-9343-97e340ac3488

	measure 'Average share of generation' = SUM(UKGrid[Share_pct]) / (DISTINCTCOUNT(UKGrid[Slot]) * 100)
		formatString: 0.0%
		lineageTag: 56bf79ad-7c22-517d-9513-58cb8f653285

	measure 'Clean half-hours' = DIVIDE(CALCULATE(DISTINCTCOUNT(UKGrid[Slot]), UKGrid[Intensity_index] = "1 Very low" || UKGrid[Intensity_index] = "2 Low"), DISTINCTCOUNT(UKGrid[Slot]))
		formatString: 0.0%
		lineageTag: 8466a7c0-4fd1-5230-af0f-66e94b535395

	column Slot
		dataType: string
