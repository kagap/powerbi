table EuroRates
	lineageTag: d5740d44-14d9-507b-ac64-e61c9bd4af94

	measure Fixings = COUNTROWS(EuroRates)
		formatString: #,0
		lineageTag: 5d9f4411-70b5-5211-86ee-11cbba619e86

	measure 'Average rate' = AVERAGE(EuroRates[Rate])
		formatString: 0.0000
		lineageTag: 4aabfba0-c61f-5153-ba01-20afa5434135

	measure 'Strength index (2015 is 100)' = AVERAGE(EuroRates[Strength_index])
		formatString: 0.0
		lineageTag: 0f631990-3102-524e-8258-b33dd366e73f

	measure 'Volatility a year' = STDEV.P(EuroRates[Daily_change]) * SQRT(250)
		formatString: 0.0%
		lineageTag: 79751b28-ac68-53cf-8e51-52fef4f22808

	measure 'Euro change over the year' = AVERAGE(EuroRates[Year_change])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 240f3c14-9745-5105-839b-b4c880fe2742

	measure 'Biggest one-day rise of the euro' = MAX(EuroRates[Daily_change])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 689fe9e4-1139-582c-bb49-e782a9def514

	measure 'Biggest one-day fall of the euro' = MIN(EuroRates[Daily_change])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 007742af-7724-5d16-851e-0b16986d49b5

	measure Currencies = DISTINCTCOUNT(EuroRates[Currency])
		formatString: #,0
		lineageTag: 76096755-d1ab-5f0b-b4de-58fccf81def9

	measure 'First fixing' = MIN(EuroRates[Date])
		formatString: yyyy-MM-dd
		lineageTag: ff35703d-afc4-5aa6-9a23-6f529be96c40

	measure 'Last fixing' = MAX(EuroRates[Date])
		formatString: yyyy-MM-dd
		lineageTag: 14f8ae7a-a8ea-58d5-a70f-b81a23048ed0

	measure 'US dollars per euro' = CALCULATE(AVERAGE(EuroRates[Rate]), EuroRates[Currency_code] = "USD")
		formatString: 0.000
		lineageTag: 4f85f49e-c1de-5ea6-914c-b5cfe7288276

	measure 'Pounds per euro' = CALCULATE(AVERAGE(EuroRates[Rate]), EuroRates[Currency_code] = "GBP")
		formatString: 0.000
		lineageTag: 27e10dee-91fb-5219-a30f-1fb6e5e0333b

	measure 'Yen per euro' = CALCULATE(AVERAGE(EuroRates[Rate]), EuroRates[Currency_code] = "JPY")
		formatString: 0.0
		lineageTag: 715d6476-c9f4-5ca6-918d-b5a8f7f0c257

	measure 'Swiss francs per euro' = CALCULATE(AVERAGE(EuroRates[Rate]), EuroRates[Currency_code] = "CHF")
		formatString: 0.000
		lineageTag: e021d90b-352f-57fb-97fd-15590899abef

	measure 'Euro change for colour' = VAR v = AVERAGE(EuroRates[Year_change]) RETURN IF(ISBLANK(v), BLANK(), MAX(-0.3, MIN(0.3, v)))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 6cb01dda-cc8e-5dd4-9678-e32746c21613

	column Date
		dataType: dateTime
		formatString: Short Date
		lineageTag: f0651a99-a0e4-53b2-b729-41fee6670828
		summarizeBy: none
		sourceColumn: "Date"

	column Currency
		dataType: string
		lineageTag: c8a4e2b9-d4c5-57d4-b211-3a4a2f8c0688
		summarizeBy: none
		sourceColumn: "Currency"

	column Region_group
		dataType: string
		lineageTag: e4f5cc62-714b-59b5-9e79-b9375e1201f5
		summarizeBy: none
		sourceColumn: "Region_group"

	column Status
		dataType: string
		lineageTag: 119b8845-b660-5f10-8fd1-f2dc193df0ee
		summarizeBy: none
		sourceColumn: "Status"

	column Era
		dataType: string
		lineageTag: afc2893b-3ed8-5d09-9c62-11c563b842fd
		summarizeBy: none
		sourceColumn: "Era"

	column Currency_code
		dataType: string
		lineageTag: 74a3c0db-3639-537d-a7b1-c5dabfbeef0e
		summarizeBy: none
		sourceColumn: "Currency_code"

	column Rate
		dataType: double
		formatString: #,0.00
		lineageTag: 9c7b235f-7a9d-5d1b-969a-cef1174614b3
		summarizeBy: none
		sourceColumn: "Rate"

	column Daily_change
		dataType: double
		formatString: #,0.00
		lineageTag: 088befc1-beaf-5380-922a-a3698da1e369
		summarizeBy: none
		sourceColumn: "Daily_change"

	column Year_change
		dataType: double
		formatString: #,0.00
		lineageTag: df06c379-1f69-5297-8a90-e157789a00dc
		summarizeBy: none
		sourceColumn: "Year_change"

	column Strength_index
		dataType: double
		formatString: #,0.00
		lineageTag: 0fccd8dc-d47b-5a92-96d1-e0afb9a7fa46
		summarizeBy: none
		sourceColumn: "Strength_index"

	column Is_latest
		dataType: int64
		formatString: 0
		lineageTag: f15c3e27-0e9e-54e7-bb12-de0534c01a8b
		summarizeBy: none
		sourceColumn: "Is_latest"

	column Month
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: ff34cd3c-99be-5731-a96a-82548a2e7e87
		summarizeBy: none
		sourceColumn: "Month"

	column Year
		dataType: int64
		formatString: 0
		lineageTag: eb66c408-a88e-544b-97b2-b6a5f66108a3
		summarizeBy: none
		sourceColumn: "Year"

