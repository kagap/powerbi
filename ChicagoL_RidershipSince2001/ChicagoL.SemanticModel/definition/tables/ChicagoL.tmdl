table ChicagoL
	lineageTag: 2f047107-dca0-5d0f-a3f9-81fdefd5e4f4

	measure 'Station records' = COUNTROWS(ChicagoL)
		formatString: #,0
		lineageTag: ed2ceeb5-b1fb-51c3-a327-000d1cb1c544

	measure Rides = SUM(ChicagoL[Rides_total])
		formatString: #,0
		lineageTag: b77f2eed-05de-55a8-a1f6-f0792e3a03ab

	measure 'Average daily boardings per station' = DIVIDE(SUM(ChicagoL[Rides_total]), SUM(ChicagoL[Days_total]))
		formatString: #,0
		lineageTag: 4435e58a-189f-52be-9101-6a63d6d013f4

	measure Stations = DISTINCTCOUNT(ChicagoL[Station_id])
		formatString: #,0
		lineageTag: 10537849-27bf-5e63-9594-a719e9340b5c

	measure 'Weekday share' = DIVIDE(SUM(ChicagoL[Rides_weekday]), SUM(ChicagoL[Rides_total]))
		formatString: 0.0%
		lineageTag: d57b1e47-27a0-51eb-982f-49efec452649

	measure 'Share of the 2019 level' = DIVIDE(SUM(ChicagoL[Rides_comparable]), SUM(ChicagoL[Rides_2019_same_month]))
		formatString: 0.0%
		lineageTag: b34b2a91-e9b3-58d7-b30c-a5bde259d7ec

	measure 'Station latitude' = AVERAGE(ChicagoL[Latitude])
		formatString: 0.000
		lineageTag: bbe1bf12-21fd-51cb-b143-93f70d408f9b

	measure 'Station longitude' = AVERAGE(ChicagoL[Longitude])
		formatString: 0.000
		lineageTag: 71c721f7-0f1a-5633-bb9d-5be603056402

	measure 'Weekday rides' = SUM(ChicagoL[Rides_weekday])
		formatString: #,0
		lineageTag: 038c0f06-721c-5422-93c8-a6bb01223fda

	measure 'Saturday rides' = SUM(ChicagoL[Rides_saturday])
		formatString: #,0
		lineageTag: aae2b21c-5b7c-58c4-b0e5-72e4f591adf4

	measure 'Sunday and holiday rides' = SUM(ChicagoL[Rides_sunday])
		formatString: #,0
		lineageTag: 5b178f8e-c72e-5816-8671-34f3f9265217

