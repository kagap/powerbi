  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Boardings at the stations of Chicago's L: the daily station entries counted by the Chicago Transit Authority, added up for every station and month, 42,786 rows for 148 stations from January 2001 to December 2025 (2026 is left out because the year is not complete). A ride is a person entering a station, not a trip. Four stations in the data have since closed or been replaced and have no line data; they stay under Closed station. The share of the 2019 level compares every station and month with the same station and the same calendar month of 2019 (a station with no 2019 figure is left out of the comparison). Lines come from the CTA list of L stops: a station that serves several lines is Multiple lines, which includes the big transfer stations of the Loop; the colours of the lines are the colours of the CTA map.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to use it",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Open the Filters pane on the right (the funnel tab) to filter by category or date; the selection applies to every page. Click a bar, a slice or a point to cross-filter the other charts, and hover over one to see a small summary card.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data source",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Chicago Transit Authority through the City of Chicago Data Portal, CTA - Ridership - 'L' Station Entries - Daily Totals (https://data.cityofchicago.org/resource/5neh-572f) and CTA - System Information - List of 'L' Stops (https://data.cityofchicago.org/resource/8pix-ypme); public data published under the portal's terms of use, retrieved on 26 October 2026. Prepared: the daily totals were added up by month, station and day type (weekday, Saturday, Sunday or holiday), joined to the stops by station id, and an era, a line group, the 2019 comparison and the status in 2025 were added.",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Measures",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Station records = COUNTROWS(ChicagoL)",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rides = SUM(ChicagoL[Rides_total])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Average daily boardings per station = DIVIDE(SUM(ChicagoL[Rides_total]), SUM(ChicagoL[Days_total]))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Stations = DISTINCTCOUNT(ChicagoL[Station_id])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Weekday share = DIVIDE(SUM(ChicagoL[Rides_weekday]), SUM(ChicagoL[Rides_total]))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Share of the 2019 level = DIVIDE(SUM(ChicagoL[Rides_comparable]), SUM(ChicagoL[Rides_2019_same_month]))",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Station latitude = AVERAGE(ChicagoL[Latitude])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Station longitude = AVERAGE(ChicagoL[Longitude])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Weekday rides = SUM(ChicagoL[Rides_weekday])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Saturday rides = SUM(ChicagoL[Rides_saturday])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sunday and holiday rides = SUM(ChicagoL[Rides_sunday])",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
