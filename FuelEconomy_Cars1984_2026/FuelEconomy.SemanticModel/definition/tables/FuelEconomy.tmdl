table FuelEconomy
	lineageTag: ea211833-9cc8-5ac9-884a-2b18b153c9a0

	measure Vehicles = COUNTROWS(FuelEconomy)
		formatString: #,0
		lineageTag: fa838100-fdea-53e8-b9f8-04eaaaab43cf

	measure 'Average MPG (not electric)' = CALCULATE(AVERAGE(FuelEconomy[MPG_combined]), FuelEconomy[Fuel_type] <> "Electric")
		formatString: 0.0
		lineageTag: 432cb54c-a30c-55ff-8d83-eb5475cc1c29

	measure 'Average CO2 (g per mile)' = AVERAGE(FuelEconomy[CO2_g_per_mile])
		formatString: #,0
		lineageTag: 0755108e-0a2a-5ca1-b103-59fe575937b9

	measure 'Average annual fuel cost ($)' = AVERAGE(FuelEconomy[Annual_fuel_cost])
		formatString: #,0
		lineageTag: 886b182b-ceb3-5d4e-b9bd-2fd0ff93dac1

	measure 'Average EV range (mi)' = AVERAGE(FuelEconomy[EV_range_miles])
		formatString: #,0
		lineageTag: 10297baa-fed4-510f-87bc-5d6da8a15c81

	measure 'Electric share of models' = DIVIDE(CALCULATE(COUNTROWS(FuelEconomy), FuelEconomy[Fuel_type] = "Electric"), COUNTROWS(FuelEconomy))
		formatString: 0.0%
		lineageTag: 3905d646-8455-5f1d-bb63-775cda1fc9fe

	measure 'Hybrid and electric share' = DIVIDE(CALCULATE(COUNTROWS(FuelEconomy), FuelEconomy[Fuel_type] IN {"Electric", "Hybrid", "Plug-in hybrid"}), COUNTROWS(FuelEconomy))
		formatString: 0.0%
		lineageTag: 334ba27b-7e03-5cbf-9c05-4618d7b110b4

	measure 'Electric models' = CALCULATE(COUNTROWS(FuelEconomy), FuelEconomy[Fuel_type] = "Electric")
		formatString: #,0
		lineageTag: e4dbade0-259d-540c-9fa1-c72fec51e405

