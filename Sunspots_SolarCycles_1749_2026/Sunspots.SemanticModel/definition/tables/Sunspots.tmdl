table Sunspots
	lineageTag: 986b4671-512d-583f-a955-c110624f6960

	measure Months = COUNTROWS(Sunspots)
		formatString: #,0
		lineageTag: f496385f-4eb7-5756-a80f-7a732bf6bcac

	measure 'Average sunspot number' = AVERAGE(Sunspots[Sunspot_number])
		formatString: 0.0
		lineageTag: 2a080a68-a73d-5b51-9231-896424fb42e6

	measure 'Smoothed number (13 months)' = AVERAGE(Sunspots[Smoothed])
		formatString: 0.0
		lineageTag: ef50a928-031c-59db-b92c-7082835aeed4

	measure 'Highest month' = MAX(Sunspots[Sunspot_number])
		formatString: 0.0
		lineageTag: 4db3395a-878f-5109-88ba-7d67069cf717

	measure 'Peak of the smoothed number' = MAX(Sunspots[Smoothed])
		formatString: 0.0
		lineageTag: d249cf6c-88c5-5713-8c75-d4560b5b17a9

	measure Cycles = CALCULATE(DISTINCTCOUNT(Sunspots[Cycle]), Sunspots[Cycle] <> "Before cycle 1")
		formatString: 0
		lineageTag: 05372c12-9203-52bd-a98c-fd1f795525cd

	measure 'Cycle length (years)' = MAX(Sunspots[Cycle_length_months]) / 12
		formatString: 0.0
		lineageTag: ce25c884-e63d-59ad-8ecc-ce77aa76480d

	measure 'Share of quiet months' = DIVIDE(CALCULATE(COUNTROWS(Sunspots), Sunspots[Activity] = "1 Quiet (under 20)"), COUNTROWS(Sunspots))
		formatString: 0.0%
		lineageTag: d996d15a-5bb9-5f2b-a7cc-c7c06138c83f

	measure 'Quiet months' = CALCULATE(COUNTROWS(Sunspots), Sunspots[Activity] = "1 Quiet (under 20)")
		formatString: #,0
		lineageTag: a6c2160b-3cd5-5b3d-859e-e21fa47b1fb3

	column Date
		dataType: dateTime
