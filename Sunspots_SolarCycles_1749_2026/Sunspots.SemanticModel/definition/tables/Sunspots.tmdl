	partition Sunspots = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.Decompress(Binary.FromText("" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"" &
					"", BinaryEncoding.Base64), Compression.GZip), [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted, {{"Decade", type text}, {"Century", type text}, {"Month_name", type text}, {"Cycle", type text}, {"Cycle_year", Int64.Type}, {"Months_since_minimum", type number}, {"Activity", type text}, {"Data_quality", type text}, {"Provisional", type text}, {"Sunspot_number", type number}, {"Smoothed", type number}, {"Std_dev", type number}, {"Observations", type number}, {"Cycle_length_months", type number}, {"Cycle_peak", type number}}, "en-US"),
				Dates0 = Table.TransformColumns(Typed, {{"Date", each if _ = null or _ = "" then null else Date.FromText(Text.From(_), [Culture="en-US", Format="yyyy-MM-dd"]), type date}}),
				AddMonth = Table.AddColumn(Dates0, "Month", each Date.StartOfMonth(DateTime.Date(Record.Field(_, "Date"))), type date),
				AddYear = Table.AddColumn(AddMonth, "Year", each Date.Year(Record.Field(_, "Month")), Int64.Type)
			in
				AddYear
