table AirbnbBarcelona
	lineageTag: 5b90bc24-49cd-5199-a22d-5ed5804e3c1d

	measure Listings = COUNTROWS(AirbnbBarcelona)
		formatString: #,0
		lineageTag: 6363bccf-1a6a-5a48-bd81-14f480af1cee

	measure 'Average price' = AVERAGE(AirbnbBarcelona[Price])
		formatString: #,0
		lineageTag: 693f2d12-801a-520b-a906-9fdba821fc34

	measure 'Median price' = MEDIAN(AirbnbBarcelona[Price])
		formatString: #,0
		lineageTag: d35458fe-5551-522c-b1ab-0b47ade2e102

	measure 'Average rating' = AVERAGE(AirbnbBarcelona[Rating])
		formatString: 0.00
		lineageTag: d4c3e7c4-5886-58e6-b910-6f6b4a12157c

	measure 'Share of superhosts' = DIVIDE(CALCULATE(COUNTROWS(AirbnbBarcelona), AirbnbBarcelona[Superhost] = "Superhost"), COUNTROWS(AirbnbBarcelona))
		formatString: 0.0%
		lineageTag: c2141068-f2b5-5e8c-b447-627e15cb20a7

	measure 'Share of entire homes' = DIVIDE(CALCULATE(COUNTROWS(AirbnbBarcelona), AirbnbBarcelona[Room_type] = "Entire home/apt"), COUNTROWS(AirbnbBarcelona))
		formatString: 0.0%
		lineageTag: c60ad05a-6187-5ca8-b267-45b3ea0cb05f

	measure 'Share of professional hosts' = DIVIDE(CALCULATE(COUNTROWS(AirbnbBarcelona), AirbnbBarcelona[Host_listings] >= 10), COUNTROWS(AirbnbBarcelona))
		formatString: 0.0%
		lineageTag: 8f56f4ba-9aff-5308-93be-28b6b053a4c8

	measure 'Average availability (days)' = AVERAGE(AirbnbBarcelona[Availability_365])
		formatString: 0
		lineageTag: 4381fb75-983f-59a1-8ccb-8208bfa4e0f6

	measure 'Reviews in the last 12 months' = SUM(AirbnbBarcelona[Reviews_last_12_months])
		formatString: #,0
		lineageTag: c2e015b1-51dc-5776-9ec2-ab3859aab180

	measure Hosts = DISTINCTCOUNT(AirbnbBarcelona[Host_id])
		formatString: #,0
		lineageTag: c2c7105d-1799-5d11-a006-45e5f97c3d9e

	measure Neighbourhoods = DISTINCTCOUNT(AirbnbBarcelona[Neighbourhood])
		formatString: #,0
		lineageTag: 0384ee56-aada-5654-bab0-0e530bf30ad0

	measure 'Cell longitude' = AVERAGE(AirbnbBarcelona[Cell_lon])
		formatString: 0.000
		lineageTag: 2d3f825b-c452-5bf7-a20d-03bbcaa8e70f

	measure 'Cell latitude' = AVERAGE(AirbnbBarcelona[Cell_lat])
		formatString: 0.000
		lineageTag: 5c51fd46-0331-5f2c-bc45-a325a94e59da

	measure 'Average price per guest' = AVERAGE(AirbnbBarcelona[Price_per_guest])
		formatString: #,0
		lineageTag: a28c0ab9-2942-5db6-b584-114ba8f1f3b9

