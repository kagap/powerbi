table Satellites
	lineageTag: 585971c2-fcfb-54c8-867c-d24d04788b47

	measure Payloads = COUNTROWS(Satellites)
		formatString: #,0
		lineageTag: a0dc9822-aea3-5cc3-ae88-a7927e83202a

	measure Launches = DISTINCTCOUNT(Satellites[Launch_id])
		formatString: #,0
		lineageTag: eea80fc6-9348-588e-ad32-f453d4817045

	measure 'Payloads still up' = CALCULATE(COUNTROWS(Satellites), Satellites[Fate] = "Still up")
		formatString: #,0
		lineageTag: 96822876-b303-5068-9332-af108472803c

	measure 'Share still up' = DIVIDE(CALCULATE(COUNTROWS(Satellites), Satellites[Fate] = "Still up"), COUNTROWS(Satellites))
		formatString: 0.0%
		lineageTag: 5b4d16ae-d3cf-5c38-b828-ca28526df56f

	measure 'Mass launched (tonnes)' = SUM(Satellites[Mass_kg]) / 1000
		formatString: #,0
		lineageTag: f2416a03-1c63-50d1-9398-5b9f885c3cc2

	measure 'Average mass (kg)' = AVERAGE(Satellites[Mass_kg])
		formatString: #,0
		lineageTag: 7b820b08-6b58-5cf6-be92-b42fed4ae18b

	measure 'Median mass (kg)' = MEDIAN(Satellites[Mass_kg])
		formatString: #,0
		lineageTag: d49bed20-0510-5d7c-94a0-206bb9698719

	measure Countries = DISTINCTCOUNT(Satellites[Country])
		formatString: #,0
		lineageTag: 81a0ad89-0951-556a-8fca-42c62944749a

	measure 'Average altitude (km)' = AVERAGE(Satellites[Altitude_km])
		formatString: #,0
		lineageTag: 26eb8e2c-c69a-5955-803d-e6b45aed7e79

	measure 'Average inclination (degrees)' = AVERAGE(Satellites[Inclination])
		formatString: 0.0
		lineageTag: 508a3f03-3207-5c56-92d4-41620409381d

	measure 'Starlink payloads' = CALCULATE(COUNTROWS(Satellites), Satellites[Constellation] = "Starlink")
		formatString: #,0
		lineageTag: 57580815-ddf2-507b-9c3a-9542f6138e40

	measure 'Starlink share' = DIVIDE(CALCULATE(COUNTROWS(Satellites), Satellites[Constellation] = "Starlink"), COUNTROWS(Satellites))
		formatString: 0.0%
		lineageTag: 4a5efa8f-9042-5639-a7e3-e6ed8aff669b

	measure 'Heaviest payload (kg)' = MAX(Satellites[Mass_kg])
		formatString: #,0
		lineageTag: 0828b823-27bb-52b2-9c85-874cc914496d

	measure 'Payloads per launch' = DIVIDE(COUNTROWS(Satellites), DISTINCTCOUNT(Satellites[Launch_id]))
		formatString: 0.0
		lineageTag: e2e6c1bc-ff69-50e7-97db-ad601ef06d77

	measure 'First year' = MIN(Satellites[Year])
		formatString: 0
		lineageTag: 4a74e168-806a-5cd7-a274-372e89ec62ab

	column Date
		dataType: dateTime
		formatString: Short Date
