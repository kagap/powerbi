table NobelLaureates
	lineageTag: 790b5c7f-d7b9-5bdc-829c-e84506e44596

	measure Laureates = COUNTROWS(NobelLaureates)
		formatString: #,0
		lineageTag: 77b6c012-1453-5fa0-8548-5a006b8d117d

	measure 'Prizes awarded' = DISTINCTCOUNT(NobelLaureates[Prize])
		formatString: #,0
		lineageTag: affd2f6d-9234-5a14-bac2-44910da85fc2

	measure 'Share of women' = DIVIDE(CALCULATE(COUNTROWS(NobelLaureates), NobelLaureates[Gender] = "Woman"), COUNTROWS(NobelLaureates))
		formatString: 0.0%
		lineageTag: 80212b0f-43bd-599e-8fc2-531826b6b7ee

	measure Women = CALCULATE(COUNTROWS(NobelLaureates), NobelLaureates[Gender] = "Woman")
		formatString: #,0
		lineageTag: 5228e2bd-1262-5f0b-ad9a-c1442427766d

	measure 'Average age' = AVERAGE(NobelLaureates[Age_at_award])
		formatString: 0.0
		lineageTag: 7d331c73-8c2b-5ac2-ae6e-c0cc6123732d

	measure 'Median age' = MEDIAN(NobelLaureates[Age_at_award])
		formatString: 0.0
		lineageTag: d9a65343-2295-51b1-9733-8305ed120d06

	measure Countries = CALCULATE(DISTINCTCOUNT(NobelLaureates[Birth_country]), NobelLaureates[Birth_country] <> "Unknown")
		formatString: #,0
		lineageTag: b97fdcde-94f4-55d0-9908-921caa30e816

	measure 'Laureates per prize' = DIVIDE(COUNTROWS(NobelLaureates), DISTINCTCOUNT(NobelLaureates[Prize]))
		formatString: 0.0
		lineageTag: 8ef5717b-12a4-5923-8ce4-ee5b8ffcabd7

	measure Youngest = MIN(NobelLaureates[Age_at_award])
		formatString: 0
		lineageTag: 19f9b7dd-cbab-5005-a8ad-41bada186654

	measure Oldest = MAX(NobelLaureates[Age_at_award])
		formatString: 0
		lineageTag: bda8ebbf-caf8-58fd-b183-8b136bb45edf

	measure 'Award year' = AVERAGE(NobelLaureates[Award_year])
		formatString: 0
		lineageTag: 4eae6b52-c635-5f15-a73a-f8acc4fbb3fc

