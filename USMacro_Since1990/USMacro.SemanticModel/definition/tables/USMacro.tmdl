	partition USMacro = m
		mode: import
		source =
			let
				Source = Csv.Document(Binary.Decompress(Binary.FromText("" &
					"" &
					"" &
					"" &
					"" &
					"", BinaryEncoding.Base64), Compression.GZip), [Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Promoted, {{"Decade", type text}, {"Recession", type text}, {"Inflation_band", type text}, {"Fed_stance", type text}, {"Unemployment_rate", type number}, {"Fed_funds_rate", type number}, {"Treasury_10y", type number}, {"Treasury_2y", type number}, {"Yield_spread_10y_2y", type number}, {"Mortgage_30y", type number}, {"CPI_index", type number}, {"Inflation_yoy", type number}, {"Payrolls_thousands", type number}, {"Payroll_growth_yoy", type number}}, "en-US"),
				Dates0 = Table.TransformColumns(Typed, {{"Date", each if _ = null or _ = "" then null else Date.FromText(Text.From(_), [Culture="en-US", Format="yyyy-MM-dd"]), type date}}),
				AddMonth = Table.AddColumn(Dates0, "Month", each Date.StartOfMonth(DateTime.Date(Record.Field(_, "Date"))), type date),
				AddYear = Table.AddColumn(AddMonth, "Year", each Date.Year(Record.Field(_, "Month")), Int64.Type)
			in
				AddYear
