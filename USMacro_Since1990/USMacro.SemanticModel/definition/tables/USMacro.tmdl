	measure 'Fed funds, change vs a year earlier' = CALCULATE(AVERAGE(USMacro[Fed_funds_rate]), USMacro[Date] = MAX(USMacro[Date])) - CALCULATE(AVERAGE(USMacro[Fed_funds_rate]), USMacro[Date] = EDATE(MAX(USMacro[Date]), -12))
