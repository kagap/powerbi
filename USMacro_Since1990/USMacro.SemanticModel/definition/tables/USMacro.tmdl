	measure 'Unemployment, change vs a year earlier' = CALCULATE(AVERAGE(USMacro[Unemployment_rate]), USMacro[Date] = MAX(USMacro[Date])) - CALCULATE(AVERAGE(USMacro[Unemployment_rate]), USMacro[Date] = EDATE(MAX(USMacro[Date]), -12))
